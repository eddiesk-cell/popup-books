{"chars":{"kapi":["kapi.0","kapi.3","kapi.1","kapi.2"]},"lines":{"kapi.0":{"en":"Hi! I'm Kapi!","lo":"ສະບາຍດີ! ຂ້ອຍຊື່ ກາປີ!","th":"สวัสดี! ฉันชื่อกาปี!","zh":"你好！我是卡皮！","ja":"やあ！ ぼく、カピだよ！","ko":"안녕! 나는 카피야!"},"kapi.3":{"en":"Hee hee!","lo":"ຄິກໆ!","th":"คิกๆ!","zh":"嘻嘻！","ja":"えへへ！","ko":"히히!"},"kapi.1":{"en":"Yum!","lo":"ແຊບ!","th":"อร่อยจัง!","zh":"真好吃！","ja":"おいしい！","ko":"냠냠!"},"kapi.2":{"en":"Whee!","lo":"ວີ້!","th":"วี้!","zh":"哇呼！","ja":"わーい！","ko":"야호!"}}}